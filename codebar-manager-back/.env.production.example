###############################################################################
# CONFIGURATION DE PRODUCTION - CODEBAR MANAGER BACKEND (LARAVEL 11)
# Adapté pour Aiven PostgreSQL & Déploiement Conteneurisé (Render, Koyeb, VPS)
###############################################################################

# --- APPLICATION ---
APP_NAME="CodeBar Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-backend-render.onrender.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# --- JOURNALISATION & LOGS (Recommandé pour Docker & Cloud PaaS) ---
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- BASE DE DONNÉES : AIVEN POSTGRESQL (Option 1 : URI globale) ---
# Vous pouvez renseigner directement la chaîne de connexion Aiven Service URI :
# DATABASE_URL=postgres://avnadmin:AVNS_xxxx@pg-xxxx.aivencloud.com:12345/defaultdb?sslmode=require

# --- BASE DE DONNÉES : AIVEN POSTGRESQL (Option 2 : Variables séparées) ---
DB_CONNECTION=pgsql
DB_HOST=pg-xxxx.aivencloud.com
DB_PORT=12345
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=VOTRE_MOT_DE_PASSE_AIVEN
DB_SSLMODE=require

# --- GESTION DES SESSIONS & DU CACHE ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- SÉCURITÉ & TOKENS SANCTUM ---
SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=*
